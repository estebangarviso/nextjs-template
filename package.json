{
	"name": "(((app-name)))",
	"version": "0.1.0",
	"private": true,
	"description": "(((project-name))) — Next.js App Router Template with DDD + Hexagonal Architecture",
	"author": "(((project-name))) Team",
	"scripts": {
		"init:project": "node scripts/init.mjs",
		"dev": "next dev --turbopack",
		"build": "next build",
		"start": "next start",
		"lint": "next lint && prettier --check .",
		"lint:fix": "next lint --fix && prettier --write .",
		"lint:style": "stylelint --cache \"src/**/*.{css,scss}\" --cache-location node_modules/.cache/stylelint/",
		"test": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest --watch",
		"test:mutation": "stryker run",
		"type-check": "tsc --noEmit",
		"openapi:gen": "openapi-typescript ${OPENAPI_SPEC_URL:-http://localhost:3001/api/openapi.json} -o src/core/api/v1.ts",
		"format": "prettier --write ."
	},
	"dependencies": {
		"@hookform/resolvers": "5.4.0",
		"@radix-ui/react-slot": "1.3.0",
		"@tanstack/react-query": "5.101.2",
		"@tanstack/react-table": "8.21.3",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"lucide-react": "1.23.0",
		"next": "16.3.2",
		"next-themes": "0.4.6",
		"openapi-fetch": "0.17.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-hook-form": "7.81.0",
		"tailwind-merge": "3.6.0",
		"zod": "4.4.3",
		"zustand": "5.0.14"
	},
	"devDependencies": {
		"@stryker-mutator/core": "9.6.1",
		"@stryker-mutator/typescript-checker": "9.6.1",
		"@stryker-mutator/vitest-runner": "9.6.1",
		"@testing-library/jest-dom": "6.9.1",
		"@testing-library/react": "16.3.2",
		"@types/node": "24.13.2",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"@vitest/coverage-v8": "4.1.10",
		"@vitejs/plugin-react-swc": "4.3.1",
		"babel-plugin-react-compiler": "1.0.0",
		"eslint": "10.6.0",
		"eslint-config-next": "16.3.2",
		"happy-dom": "20.10.6",
		"openapi-typescript": "7.13.0",
		"prettier": "3.9.4",
		"sass-embedded": "1.100.0",
		"stylelint": "17.14.0",
		"stylelint-config-rational-order": "0.1.2",
		"stylelint-config-standard": "40.0.0",
		"stylelint-config-standard-scss": "17.0.0",
		"stylelint-config-tailwindcss": "1.0.1",
		"stylelint-order": "8.1.1",
		"stylelint-prettier": "5.0.3",
		"stylelint-scss": "7.2.0",
		"stylelint-use-nesting": "6.0.2",
		"tailwindcss": "4.3.2",
		"typescript": "6.0.3",
		"vitest": "4.1.10"
	},
	"engines": {
		"node": ">=24",
		"pnpm": ">=9"
	},
	"packageManager": "pnpm@11.10.0"
}
