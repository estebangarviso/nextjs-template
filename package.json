{
	"name": "(((app-name)))",
	"version": "0.1.0",
	"private": true,
	"description": "(((project-name))) — Next.js App Router Template with DDD + Hexagonal Architecture",
	"author": "(((project-name))) Team",
	"scripts": {
		"init:project": "node scripts/init.mjs",
		"dev": "next dev --turbopack",
		"build": "next build",
		"start": "next start",
		"lint": "next lint && prettier --check .",
		"lint:fix": "next lint --fix && prettier --write .",
		"lint:style": "stylelint --cache \"src/**/*.{css,scss}\" --cache-location node_modules/.cache/stylelint/",
		"test": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest --watch",
		"test:mutation": "stryker run",
		"type-check": "tsc --noEmit",
		"openapi:gen": "openapi-typescript ${OPENAPI_SPEC_URL:-http://localhost:3001/api/openapi.json} -o src/core/api/v1.ts",
		"format": "prettier --write ."
	},
